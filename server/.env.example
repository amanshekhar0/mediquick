MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/mediequip2
JWT_SECRET=your_jwt_secret_here

# Groq (Llama) — optional; patient triage uses offline routing if unset
GROQ_API_KEY=
# Legacy alias (same value as GROQ_API_KEY)
GROK_API_KEY=

REDIS_URL=redis://localhost:6379
PORT=5000
NODE_ENV=development
# Comma-separated frontend origins (no path). Trailing slashes are normalized.
# Example: https://mediequip.vercel.app,https://www.yourdomain.com
CLIENT_ORIGIN=http://localhost:5173
# Set to true to allow any https://*.vercel.app (preview deploys) without listing each URL
# ALLOW_VERCEL_PREVIEWS=true
